import axios from 'axios';

// Création de l'instance API
const api = axios.create({
  baseURL: process.env.NEXT_PUBLIC_API_URL || 'http://127.0.0.1:8000/api',
  withCredentials: true,
  headers: {
    "Content-Type": "application/json",
    "Accept": "application/json",
  },
});

// État du CSRF token
const csrfState = {
  initialized: false
};

async function initializeCsrf() {
  if (!csrfState.initialized) {
    try {
      await axios.get('http://127.0.0.1:8000/sanctum/csrf-cookie', {
        withCredentials: true
      });
      csrfState.initialized = true;
    } catch (error) {
      console.warn('Impossible d\'initialiser le CSRF token:', error);
    }
  }
}

// Intercepteur pour les requêtes
api.interceptors.request.use(async function(config) {
  try {
    await initializeCsrf();
    
    const token = localStorage.getItem('auth_token');
    if (token) {
      config.headers['Authorization'] = `Bearer ${token}`;
    }
    
    console.log('Requête sortante:', {
      url: config.url,
      method: config.method,
      headers: config.headers,
      data: config.data
    });
    
    return config;
  } catch (error) {
    console.error('Erreur dans la configuration de la requête:', error);
    return Promise.reject(error);
  }
}, function(error) {
  console.error('Erreur dans l\'intercepteur de requête:', error);
  return Promise.reject(error);
});

// Intercepteur pour les réponses
api.interceptors.response.use(
  function(response) {
    if (response.data === undefined || response.data === null) {
      return Promise.reject(new Error('La réponse ne contient pas de données'));
    }
    return response;
  },
  function(error) {
    console.error('Erreur dans la réponse:', error);
    const errorDetails = {
      status: error.response?.status || 'unknown',
      statusText: error.response?.statusText || 'Erreur inconnue',
      message: error.response?.data?.message || error.message || 'Une erreur est survenue',
      url: error.config?.url || 'URL inconnue',
      method: error.config?.method || 'Méthode inconnue',
      data: error.config?.data,
      requestHeaders: error.config?.headers || {},
      responseHeaders: error.response?.headers || {},
      timestamp: new Date().toISOString()
    };

    error.details = errorDetails;
    return Promise.reject(error);
  }
);

export default api;

